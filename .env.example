# ============================================================
# BULKORA — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Cloudinary (image uploads) ────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Only needed for unsigned uploads (not used — we use signed uploads)
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ── Admin ─────────────────────────────────────────────────
# Email address of the admin account (used for fast-path admin check)
NEXT_PUBLIC_ADMIN_EMAIL=admin@yoursite.com
# Server-only admin email (more secure — not exposed in client bundle)
# If set, this takes priority over NEXT_PUBLIC_ADMIN_EMAIL
ADMIN_EMAIL=admin@yoursite.com

# ── Cron (product expiry auto-deactivation) ───────────────
# Secret token to protect the /api/cron/expire-products endpoint
# Set this in Vercel env vars and add as Authorization: Bearer <token> in Vercel Cron config
CRON_SECRET=your_random_secret_here

# ── Supabase SQL to run ───────────────────────────────────
# Run supabase/subscription_tiers_migration.sql in Supabase SQL Editor
# This sets up:
#   - subscription_tier column
#   - notifications table
#   - support_tickets table
#   - view_count column on products
#   - expires_at column on products
#   - JWT metadata sync trigger (sync_user_metadata)
#   - increment_view_count() RPC
#   - search_products_tiered() RPC

# ── Supabase Connection Pooler (CRITICAL for performance) ─
# Add this to fix the 30s buffering issue on Vercel
# Get from: Supabase Dashboard → Project Settings → Database → Connection Pooling
# Use "Transaction" mode URL (port 6543)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
